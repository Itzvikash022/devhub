# DevHub Environment Variables
# Copy this file to .env.local and fill in the values

# ─── Application ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── MongoDB ─────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/devhub?retryWrites=true&w=majority

# ─── JWT Authentication ───────────────────────────────────────────────────────
# Generate with: openssl rand -base64 64
JWT_ACCESS_SECRET=your-access-token-secret-here
JWT_REFRESH_SECRET=your-refresh-token-secret-here

# ─── Password Vault Encryption ────────────────────────────────────────────────
# Must be exactly 64 hex characters (32 bytes for AES-256)
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=your-64-hex-character-encryption-key-here

# ─── Cloudflare R2 ───────────────────────────────────────────────────────────
CLOUDFLARE_R2_ACCOUNT_ID=your-account-id
CLOUDFLARE_R2_ACCESS_KEY_ID=your-access-key-id
CLOUDFLARE_R2_SECRET_ACCESS_KEY=your-secret-access-key
CLOUDFLARE_R2_BUCKET_NAME=devhub
CLOUDFLARE_R2_PUBLIC_URL=https://pub-xxxx.r2.dev
